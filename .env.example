# Mind Athlete — environment configuration
#
# Nothing in this build currently reads these variables (see README "What's
# implemented" — this is a client-only, guest-mode slice). They're documented
# here as the interface the backend phases will need, so adding them later is
# additive rather than a redesign.

# --- Public (safe to expose to the browser) ---
VITE_APP_URL=http://localhost:5173

# --- Private (server-only, never reference with a VITE_ prefix) ---
# DATABASE_URL=postgres://user:password@host:5432/mind_athlete
# AUTH_SESSION_SECRET=
# AI_PROVIDER_API_KEY=
# AD_PROVIDER_API_KEY=
